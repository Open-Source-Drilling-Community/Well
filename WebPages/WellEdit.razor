        _wellFeatureCategories.FirstOrDefault(item => item.MetaInfo?.ID == assignment.FeatureCategoryID)?.HasValidityPeriod == true;

    private bool ValidateCatalogAssignments()
    {
        if (_wellIdentityAssignments.Any(item => item.IdentityID == null || string.IsNullOrWhiteSpace(item.Value)))
        {
            Snackbar.Add("Every identity assignment requires an identity and value", Severity.Warning);
            return false;
        }
        if (_wellFeatureAssignments.Any(item => item.FeatureCategoryID == null || item.FeatureOptionID == null ||
            (item.FromDate != null && item.ToDate != null && item.FromDate > item.ToDate)))
        {
            Snackbar.Add("Feature assignments require a valid category, option, and date range", Severity.Warning);
            return false;
        }
        return true;
    }

