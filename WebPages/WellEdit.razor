    private void AssignFeature()
    {
        if (_selectedFeatureCategoryId is not Guid categoryId || _selectedFeatureOptionId is not Guid optionId) return;
        WellFeatureCategory? category = _wellFeatureCategories.FirstOrDefault(item => item.MetaInfo?.ID == categoryId);
        if (category == null || category.Options?.Any(item => item.ID == optionId) != true) return;
        if (category.IsExclusive && _wellFeatureAssignments.Any(item => item.FeatureCategoryID == categoryId))
        {
            Snackbar.Add($"Only one '{category.Name}' assignment is allowed at a time", Severity.Warning);
            return;
        }
        _wellFeatureAssignments.Add(new WellFeatureAssignment
        {
            ID = Guid.NewGuid(), FeatureCategoryID = categoryId, FeatureOptionID = optionId
        });
    }

    private string GetFeatureName(WellFeatureAssignment assignment)
    {
        WellFeatureCategory? category = _wellFeatureCategories.FirstOrDefault(item => item.MetaInfo?.ID == assignment.FeatureCategoryID);
        WellFeatureOption? option = category?.Options?.FirstOrDefault(item => item.ID == assignment.FeatureOptionID);
        return $"{category?.Name ?? "Unknown category"}: {option?.Name ?? "Unknown option"}";
    }

